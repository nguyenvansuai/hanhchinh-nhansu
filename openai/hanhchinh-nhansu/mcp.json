{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hcns-cong-cu": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/mcp/server.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PLUGIN_MCP_NAME": "hcns-cong-cu"
      }
    }
  }
}
